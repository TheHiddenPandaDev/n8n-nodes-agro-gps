{
	"name": "n8n-nodes-agro-gps",
	"version": "0.1.0",
	"description": "n8n nodes for Agro GPS: register farm operations, check plant protection products and their conditions of use in 30 European registers, list and create fields, and react to farm diary events",
	"license": "MIT",
	"homepage": "https://agrogps.eu",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"agro-gps",
		"agriculture",
		"farm",
		"farm-management",
		"spray-journal",
		"plant-protection",
		"pesticides",
		"field-records",
		"precision-agriculture",
		"europe"
	],
	"author": {
		"name": "The Hidden Panda",
		"email": "soporte@agrogps.eu"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TheHiddenPandaDev/n8n-nodes-agro-gps.git"
	},
	"bugs": {
		"url": "https://github.com/TheHiddenPandaDev/n8n-nodes-agro-gps/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AgroGpsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/AgroGps/AgroGps.node.js",
			"dist/nodes/AgroGpsTrigger/AgroGpsTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@vitest/coverage-v8": "^3.2.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"vitest": "^3.2.4"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
