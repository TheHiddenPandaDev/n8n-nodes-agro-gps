{
    "url": "/api/v1/webhooks",
    "method": "POST",
    "body": {
        "url": "{{webhook.url}}",
        "events": "{{parameters.events}}"
    },
    "response": {
        "data": {
            "externalHookId": "{{body.data.id}}",
            "secret": "{{body.data.secret}}"
        }
    }
}
