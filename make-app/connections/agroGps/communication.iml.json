{
    "url": "https://api.agrogps.eu/api/v1/farms",
    "method": "GET",
    "headers": {
        "X-API-Key": "{{parameters.apiKey}}",
        "Accept": "application/json"
    },
    "response": {
        "valid": "{{statusCode === 200}}",
        "error": {
            "message": "[{{statusCode}}] {{ifempty(body.message, \"Invalid API key\")}}",
            "type": "InvalidAccessTokenError"
        }
    },
    "log": {
        "sanitize": [
            "request.headers.x-api-key"
        ]
    }
}
